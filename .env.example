# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed front-end origins (CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL 14+) ----
DATABASE_URL=postgres://skp:skp@localhost:5432/skp

# ---- First admin (used by `npm run seed`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-123
ADMIN_NAME=SKP Admin

# ---- Email (leave SMTP_HOST empty to log emails to the console + notifications table) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SKP Sports <no-reply@example.com>"
# Where new-booking and contact-form alerts go
ADMIN_NOTIFY_EMAIL=

# ---- Payments (NOT implemented: needs client decision + gateway credentials) ----
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
